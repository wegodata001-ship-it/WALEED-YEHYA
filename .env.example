# Supabase PostgreSQL — transaction pooler (runtime queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL — session pooler (migrations / db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

JWT_SECRET="change-me-to-a-long-random-secret"
WHATSAPP_MANAGER_PHONE="9725XXXXXXXX"

# Supabase Storage — private bucket + signed URLs
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_STORAGE_BUCKET="photo-buc"
STORAGE_SIGNED_URL_EXPIRES_SEC=3600

MAX_UPLOAD_IMAGES=10
MAX_IMAGE_SIZE_MB=10
MAX_UPLOAD_VIDEO=1
MAX_VIDEO_DURATION_SECONDS=10
MAX_VIDEO_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
